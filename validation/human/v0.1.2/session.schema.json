{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifeOS v0.1.2 Human Validation Session",
  "type": "object",
  "required": ["session_id", "case_id", "user_id", "date", "runtime_level", "candidate_activation", "accepted_outcome", "clarity_before", "clarity_after", "autonomy", "process_cost", "p0", "p1"],
  "properties": {
    "session_id": {"type": "string"},
    "case_id": {"type": "string"},
    "user_id": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "runtime_level": {"enum": ["quick", "standard", "deep"]},
    "candidate_activation": {"type": "array", "uniqueItems": true, "items": {"enum": ["C1", "C2", "C3"]}},
    "assistance_mode": {"enum": ["Answer", "Guide", "Coach", "Collaborate", "Review", "Step Back"]},
    "independent_work_before": {"type": "string"},
    "lifeos_contribution": {"type": "string"},
    "accepted_outcome": {"type": "string", "minLength": 1},
    "outcome_type": {"enum": ["action", "explore", "wait", "no_action"]},
    "checkpoint": {"type": "string"},
    "clarity_before": {"type": "integer", "minimum": 1, "maximum": 5},
    "clarity_after": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence_before": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence_after": {"type": "integer", "minimum": 1, "maximum": 5},
    "strategy_fit": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "assistance_appropriateness": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "calibration_quality": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "autonomy": {"type": "integer", "minimum": 1, "maximum": 5},
    "process_cost": {"type": "integer", "minimum": 1, "maximum": 5},
    "framework_burden": {"enum": ["low", "medium", "high"]},
    "analysis_paralysis": {"type": "boolean"},
    "target_evidence": {"type": ["string", "null"]},
    "judgment_evidence": {"type": ["string", "null"]},
    "candidate_transfer_lesson": {"type": ["string", "null"]},
    "observed_capability_evidence": {"type": ["string", "null"]},
    "p0": {"type": "array", "items": {"type": "string"}},
    "p1": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
